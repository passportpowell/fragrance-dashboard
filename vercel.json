{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    { "source": "/vault(.html)?", "destination": "/collection", "permanent": true },
    { "source": "/scentscapes(.html)?", "destination": "/occasions", "permanent": true },
    { "source": "/codex(.html)?", "destination": "/guide", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
